{
	"name": "df_silver_diagnoses",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_diagnoses",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "sql_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_silver_diagnoses",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "Filter"
				},
				{
					"name": "aggregate"
				},
				{
					"name": "select1"
				},
				{
					"name": "Exist1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(diagnosis_id_i = toInteger(trim(diagnosis_id)),",
				"          admission_id_i = toInteger(trim(admission_id)),",
				"          icd_raw = upper(regexReplace(split(coalesce(icd_code,''),',')[1],'[^A-Za-z0-9]','')),",
				"          description_c = iif(length(trim(coalesce(diagnosis_description,'')))==0, toString(null()), trim(diagnosis_description)),",
				"          severity_c = case(lower(trim(coalesce(severity,'')))=='mild','Mild', lower(trim(coalesce(severity,'')))=='moderate','Moderate', lower(trim(coalesce(severity,'')))=='severe','Severe', lower(trim(coalesce(severity,'')))=='critical','Critical', toString(null()))) ~> derivedColumn1",
				"derivedColumn1 derive(icd_c = iif(length(icd_raw)>3, concat(substring(icd_raw,1,3),'.',substring(icd_raw,4)), icd_raw)) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(diagnosis_id_i) && !isNull(admission_id_i) && length(icd_c) > 0) ~> Filter",
				"Filter aggregate(groupBy(diagnosis_id_i),",
				"     each(match(name!='diagnosis_id_i'), $$ = first($$))) ~> aggregate",
				"source2 select(mapColumn(",
				"          sa_admission_id = admission_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"aggregate, select1 exists(admission_id_i == sa_admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> Exist1",
				"Exist1 select(mapColumn(",
				"          diagnosis_id = diagnosis_id_i,",
				"          admission_id = admission_id_i,",
				"          icd_code = icd_c,",
				"          diagnosis_description = description_c,",
				"          severity = severity_c",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['DELETE FROM silver.diagnoses'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     )) ~> sink1"
			]
		}
	}
}