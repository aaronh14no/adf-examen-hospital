		{
			"name": "[concat(parameters('factoryName'), '/df_silver_patients')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "sql_bronze_patients",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "sql_silver_patients",
								"type": "DatasetReference"
							},
							"name": "sink"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "Filter"
						},
						{
							"name": "aggregate1"
						},
						{
							"name": "DerivedColumn3"
						}
					],
					"scriptLines": [
						"source(output(",
						"          patient_id as string,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as string,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source1 derive(patient_id_i = toInteger(trim(patient_id)),",
						"          full_name_c = initCap(regexReplace(trim(coalesce(full_name,'')),' +',' ')),",
						"          gender_l = lower(trim(coalesce(gender,''))),",
						"          dob_d = case(regexMatch(trim(coalesce(date_of_birth,'')),'^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(coalesce(date_of_birth,'')),'yyyy-MM-dd'), regexMatch(trim(coalesce(date_of_birth,'')),'^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(coalesce(date_of_birth,'')),'MM/dd/yyyy'), regexMatch(trim(coalesce(date_of_birth,'')),'^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(coalesce(date_of_birth,'')),'dd-MMM-yyyy'), regexMatch(trim(coalesce(date_of_birth,'')),'^[A-Za-z]+ [0-9]{2}, [0-9]{4}$'), toDate(trim(coalesce(date_of_birth,'')),'MMMM dd, yyyy'), regexMatch(trim(coalesce(date_of_birth,'')),'^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(substring(trim(coalesce(date_of_birth,'')),1,6), iif(toInteger(substring(trim(coalesce(date_of_birth,'')),7,2))<=27,'20','19'), substring(trim(coalesce(date_of_birth,'')),7,2)),'MM-dd-yyyy'), toDate(toString(null()))),",
						"          phone_digits = iif(length(regexReplace(coalesce(phone,''),'[^0-9]',''))==11 && startsWith(regexReplace(coalesce(phone,''),'[^0-9]',''),'1'), substring(regexReplace(coalesce(phone,''),'[^0-9]',''),2), regexReplace(coalesce(phone,''),'[^0-9]','')),",
						"          email_l = lower(trim(replace(replace(lower(coalesce(email,'')),',','.'),'gmial','gmail'))),",
						"          insurance_l = lower(regexReplace(coalesce(insurance_provider,''),'[^A-Za-z]','')),",
						"          address_c = iif(length(trim(coalesce(address,'')))==0, toString(null()), trim(address))) ~> derivedColumn1",
						"derivedColumn1 derive(gender_c = case(in(['m','male'], gender_l),'Male', in(['f','female'], gender_l),'Female', toString(null())),",
						"          dob_c = iif(!isNull(dob_d) && dob_d >= toDate('1900-01-01') && dob_d <= currentDate(), dob_d, toDate(toString(null()))),",
						"          phone_c = iif(length(phone_digits)==10, concat(substring(phone_digits,1,3),'-',substring(phone_digits,4,3),'-',substring(phone_digits,7,4)), toString(null())),",
						"          email_c = iif(regexMatch(email_l,'^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$'), email_l, toString(null())),",
						"          insurance_c = case(startsWith(insurance_l,'medicaid'),'Medicaid', startsWith(insurance_l,'medicare'),'Medicare', startsWith(insurance_l,'cigna'),'Cigna', startsWith(insurance_l,'aetna'),'Aetna', startsWith(insurance_l,'bluecross'),'BlueCross', insurance_l=='uhc' || startsWith(insurance_l,'united'),'UnitedHealthcare', startsWith(insurance_l,'selfpay'),'Self Pay', toString(null()))) ~> derivedColumn2",
						"derivedColumn2 filter(!isNull(patient_id_i) && length(full_name_c) > 0) ~> Filter",
						"Filter aggregate(groupBy(patient_id_i),",
						"     each(match(name!='patient_id_i'), $$ = first($$))) ~> aggregate1",
						"aggregate1 select(mapColumn(",
						"          patient_id = patient_id_i,",
						"          full_name = full_name_c,",
						"          gender = gender_c,",
						"          date_of_birth = dob_c,",
						"          phone = phone_c,",
						"          email = email_c,",
						"          address = address_c,",
						"          insurance_provider = insurance_c",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> DerivedColumn3",
						"DerivedColumn3 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     preSQLs:['DELETE FROM silver.billing','DELETE FROM silver.diagnoses','DELETE FROM silver.admissions','DELETE FROM silver.patients'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          patient_id,",
						"          full_name,",
						"          gender,",
						"          date_of_birth,",
						"          phone,",
						"          email,",
						"          address,",
						"          insurance_provider",
						"     )) ~> sink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/sql_bronze_patients')]",
				"[concat(variables('factoryId'), '/datasets/sql_silver_patients')]"
			]
		},
